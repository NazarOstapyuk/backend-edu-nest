  @@index([teacherId])
}

model LessonChange {
  id          String           @id @default(uuid())
  groupId     String
  group       Group            @relation(fields: [groupId], references: [id])
  date        DateTime         @db.Date
  period      Int
  subgroupId  String?
  subgroup    Subgroup?        @relation(fields: [subgroupId], references: [id], onDelete: Restrict)
