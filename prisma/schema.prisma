  @@unique([groupId, date, period, subgroupKey])
}

model LessonMark {
  id         String         @id @default(uuid())
  lessonId   String
  lesson     SchoolLesson   @relation(fields: [lessonId], references: [id])
  childId    String
  child      Child          @relation(fields: [childId], references: [id])
  status     LessonStatus
  reasonId   String?
  reason     AbsenceReason? @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  level      NushLevel?
  comment    String?
  markedById String
  markedBy   User           @relation("LessonMarkMarkedBy", fields: [markedById], references: [id])
  createdAt  DateTime       @default(now())
  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?          @relation("LessonMarkVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  @@index([lessonId])
  @@index([childId])
}

model MealCourse {
  id         String              @id @default(uuid())
  name       String              @unique
  sortOrder  Int                 @default(0)
  active     Boolean             @default(true)
  dishes     Dish[]
  complexes  MealComplexCourse[]
  orderItems MealOrderItem[]
}

model Dish {
  id            String             @id @default(uuid())
  name          String
  courseId      String
  course        MealCourse         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  description   String?
  active        Boolean            @default(true)
  menuItems     MenuDayItem[]
  templateItems MenuTemplateItem[]
  orderItems    MealOrderItem[]

  @@unique([courseId, name])
}

model MealPriceCategory {
  id        String             @id @default(uuid())
  name      String             @unique
  sortOrder Int                @default(0)
  active    Boolean            @default(true)
  groups    Group[]
  prices    MealComplexPrice[]
  orders    MealOrder[]
}

model MealComplex {
  id          String              @id @default(uuid())
  name        String              @unique
  description String?
  sortOrder   Int                 @default(0)
  active      Boolean             @default(true)
  courses     MealComplexCourse[]
  prices      MealComplexPrice[]
  orders      MealOrder[]
}

model MealComplexCourse {
  complexId String
  complex   MealComplex @relation(fields: [complexId], references: [id], onDelete: Cascade)
  courseId  String
  course    MealCourse  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([complexId, courseId])
}

model MealComplexPrice {
  id              String            @id @default(uuid())
  complexId       String
  complex         MealComplex       @relation(fields: [complexId], references: [id], onDelete: Restrict)
  priceCategoryId String
  priceCategory   MealPriceCategory @relation(fields: [priceCategoryId], references: [id], onDelete: Restrict)
  price           Decimal           @db.Decimal(10, 2)
  validFrom       DateTime          @db.Date
  createdAt       DateTime          @default(now())

  @@unique([complexId, priceCategoryId, validFrom])
}

enum MenuStatus {
  draft
  published
}

model MenuDay {
  id            String        @id @default(uuid())
  date          DateTime      @db.Date
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  status        MenuStatus    @default(draft)
