}

model MenuDayItem {
  menuDayId String
  menuDay   MenuDay @relation(fields: [menuDayId], references: [id], onDelete: Cascade)
  dishId    String
  dish      Dish    @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@id([menuDayId, dishId])
}

model MenuTemplate {
  id     String             @id @default(uuid())
  name   String             @unique
  weeks  Int
  active Boolean            @default(true)
  items  MenuTemplateItem[]
}

model MenuTemplateItem {
  templateId String
  template   MenuTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  week       Int
  weekday    Int
  dishId     String
  dish       Dish         @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@id([templateId, week, weekday, dishId])
}

model MealOrder {
  id              String            @id @default(uuid())
  childId         String
  child           Child             @relation(fields: [childId], references: [id], onDelete: Restrict)
  date            DateTime          @db.Date
  menuDayId       String
  menuDay         MenuDay           @relation(fields: [menuDayId], references: [id], onDelete: Restrict)
  complexId       String
  complex         MealComplex       @relation(fields: [complexId], references: [id], onDelete: Restrict)
  priceCategoryId String
  priceCategory   MealPriceCategory @relation(fields: [priceCategoryId], references: [id], onDelete: Restrict)
  price           Decimal           @db.Decimal(10, 2)
  chargeId        String            @unique
  charge          Charge            @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  createdById     String
  createdBy       User              @relation("MealOrderCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
