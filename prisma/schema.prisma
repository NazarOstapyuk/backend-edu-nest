generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  root
  admin
  teacher
  parent
}

enum Gender {
  male
  female
}

enum SubscriptionStatus {
  active
  finished
  cancelled
}

model User {
  id                       String                 @id @default(uuid())
  login                    String                 @unique
  password                 String
  role                     Role
  firstName                String
  lastName                 String
  middleName               String?
  phone                    String?
  email                    String?
  mustChangePassword       Boolean                @default(false)
  refreshToken             String?
  isActive                 Boolean                @default(true)
  accessScope              AccessScope            @default(all)
  institutions             UserInstitution[]
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  groups                   Group[]                @relation("GroupTeachers")
  children                 Child[]                @relation("ChildParents")
  chargesCreated           Charge[]               @relation("ChargeCreatedBy")
  chargesVoided            Charge[]               @relation("ChargeVoidedBy")
  paymentsCreated          Payment[]              @relation("PaymentCreatedBy")
  paymentsVoided           Payment[]              @relation("PaymentVoidedBy")
  allocationsCreated       Allocation[]           @relation("AllocationCreatedBy")
  allocationsVoided        Allocation[]           @relation("AllocationVoidedBy")
  tariffPricesCreated      TariffPrice[]          @relation("TariffPriceCreatedBy")
  enrollmentsCreated       Enrollment[]           @relation("EnrollmentCreatedBy")
  adjustmentsCreated       EnrollmentAdjustment[] @relation("AdjustmentCreatedBy")
  adjustmentsVoided        EnrollmentAdjustment[] @relation("AdjustmentVoidedBy")
  adaptationsCreated       AdaptationVisit[]      @relation("AdaptationCreatedBy")
  adaptationsVoided        AdaptationVisit[]      @relation("AdaptationVoidedBy")
  classGroupsTeaching      ClassGroup[]           @relation("ClassGroupTeachers")
  membersCreated           ClassGroupMember[]     @relation("MemberCreatedBy")
  packagesCreated          Package[]              @relation("PackageCreatedBy")
  packagesVoided           Package[]              @relation("PackageVoidedBy")
  packagesReconciled       Package[]              @relation("PackageReconciledBy")
  extensionsCreated        PackageExtension[]     @relation("ExtensionCreatedBy")
  lessonsConducted         Lesson[]               @relation("LessonConductedBy")
  attendancesMarked        LessonAttendance[]     @relation("AttendanceMarkedBy")
  attendancesVoided        LessonAttendance[]     @relation("AttendanceVoidedBy")
  usagesVoided             SessionUsage[]         @relation("UsageVoidedBy")
  dailyMarked              DailyAttendance[]      @relation("DailyMarkedBy")
  routineTemplatesCreated  RoutineTemplate[]      @relation("RoutineTemplateCreatedBy")
  routineDaysCreated       RoutineDay[]           @relation("RoutineDayCreatedBy")
  dailyVoided              DailyAttendance[]      @relation("DailyVoidedBy")
  calendarCreated          CalendarDay[]          @relation("CalendarCreatedBy")
  calendarVoided           CalendarDay[]          @relation("CalendarVoidedBy")
  noticesCreated           AbsenceNotice[]        @relation("NoticeCreatedBy")
  noticesDecided           AbsenceNotice[]        @relation("NoticeDecidedBy")
  timetablesCreated        Timetable[]            @relation("TimetableCreatedBy")
  entriesTaught            TimetableEntry[]       @relation("EntryTeacher")
  changesTaught            LessonChange[]         @relation("ChangeTeacher")
  changesCreated           LessonChange[]         @relation("ChangeCreatedBy")
  changesVoided            LessonChange[]         @relation("ChangeVoidedBy")
  schoolLessonsTaught      SchoolLesson[]         @relation("SchoolLessonTeacher")
  schoolLessonsLed         SchoolLesson[]         @relation("SchoolLessonConductedBy")
  lessonMarksMarked        LessonMark[]           @relation("LessonMarkMarkedBy")
  lessonMarksVoided        LessonMark[]           @relation("LessonMarkVoidedBy")
  mealOrdersCreated        MealOrder[]            @relation("MealOrderCreatedBy")
  mealOrdersCancelled      MealOrder[]            @relation("MealOrderCancelledBy")
  paymentRequestsCreated   PaymentRequest[]       @relation("PaymentRequestCreatedBy")
  paymentRequestsCancelled PaymentRequest[]       @relation("PaymentRequestCancelledBy")
  salaryTerms              SalaryTerms[]          @relation("SalaryTermsTeacher")
  salaryTermsCreated       SalaryTerms[]          @relation("SalaryTermsCreatedBy")
  payrollSheets            PayrollSheet[]         @relation("PayrollSheetTeacher")
  payrollApproved          PayrollSheet[]         @relation("PayrollSheetApprovedBy")
  payrollReopened          PayrollSheet[]         @relation("PayrollSheetReopenedBy")
  payrollAdjCreated        PayrollAdjustment[]    @relation("PayrollAdjustmentCreatedBy")
  payrollAdjVoided         PayrollAdjustment[]    @relation("PayrollAdjustmentVoidedBy")
  payrollPayCreated        PayrollPayment[]       @relation("PayrollPaymentCreatedBy")
  payrollPayVoided         PayrollPayment[]       @relation("PayrollPaymentVoidedBy")
  payrollDetailsVisible    Boolean                @default(false)
  extraHoursTeacher        PayrollExtraHours[]    @relation("PayrollExtraHoursTeacher")
  extraHoursCreated        PayrollExtraHours[]    @relation("PayrollExtraHoursCreatedBy")
  extraHoursVoided         PayrollExtraHours[]    @relation("PayrollExtraHoursVoidedBy")
  teacherAbsences          TeacherAbsence[]       @relation("TeacherAbsenceTeacher")
  teacherAbsencesCreated   TeacherAbsence[]       @relation("TeacherAbsenceCreatedBy")
  teacherAbsencesVoided    TeacherAbsence[]       @relation("TeacherAbsenceVoidedBy")
  backupRunsCreated        BackupRun[]            @relation("BackupRunCreatedBy")
  permissions              UserPermission[]
  positionId               String?
  position                 Position?              @relation(fields: [positionId], references: [id], onDelete: Restrict)
  auditEvents              AuditEvent[]           @relation("AuditEventActor")
  auditChanges             AuditChange[]          @relation("AuditChangeActor")
  authEvents               AuthEvent[]            @relation("AuthEventUser")
}

model Group {
  id                  String             @id @default(uuid())
  name                String
  teachers            User[]             @relation("GroupTeachers")
  children            Child[]
  kind                GroupKind          @default(kindergarten)
  institutionId       String
  institution         Institution        @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  dailyAttendances    DailyAttendance[]
  calendarDays        CalendarDay[]
  bellScheduleId      String?
  bellSchedule        BellSchedule?      @relation(fields: [bellScheduleId], references: [id], onDelete: Restrict)
  subgroups           Subgroup[]
  timetables          Timetable[]
  lessonChanges       LessonChange[]
  schoolLessons       SchoolLesson[]
  routineTemplates    RoutineTemplate[]
  routineDays         RoutineDay[]
  mealPriceCategoryId String?
  mealPriceCategory   MealPriceCategory? @relation(fields: [mealPriceCategoryId], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([institutionId, name])
}

model Child {
  id         String   @id @default(uuid())
  firstName  String
  lastName   String
  middleName String?
  birthDate  DateTime
  gender     Gender

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id])

  parents             User[]             @relation("ChildParents")
  subscriptions       Subscription[]
  charges             Charge[]
  payments            Payment[]
  enrollments         Enrollment[]
  adaptationVisits    AdaptationVisit[]
  classMemberships    ClassGroupMember[]
  lessonAttendances   LessonAttendance[]
  packages            Package[]
  dailyAttendances    DailyAttendance[]
  absenceNotices      AbsenceNotice[]
  subgroupMemberships SubgroupMember[]
  lessonMarks         LessonMark[]
  mealOrders          MealOrder[]
  paymentRequests     PaymentRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubscriptionType {
  id              String   @id @default(uuid())
  name            String   @unique
  pricePerSession Decimal  @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id      String @id @default(uuid())
  childId String
  child   Child  @relation(fields: [childId], references: [id])

  subscriptionTypeId String
  subscriptionType   SubscriptionType @relation(fields: [subscriptionTypeId], references: [id])

  totalSessions     Int
  remainingSessions Int
  pricePerSession   Decimal @db.Decimal(10, 2)
  totalPrice        Decimal @db.Decimal(10, 2)

  status SubscriptionStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendances Attendance[]
  package     Package?
}

model Attendance {
  id             String       @id @default(uuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])

  date DateTime @default(now())
  note String?

  createdAt DateTime @default(now())
}

enum FinanceCategory {
  tuition
  adaptation
  extra_classes
  meals
}

enum ChargeSource {
  manual
  opening_balance
  monthly
  adaptation
  extra_package
  extra_session
  meals
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  online
}

enum PaymentStatus {
  pending
  confirmed
  failed
}

model Charge {
  id          String          @id @default(uuid())
  childId     String
  child       Child           @relation(fields: [childId], references: [id])
  category    FinanceCategory
  amount      Decimal         @db.Decimal(10, 2)
  description String
  periodStart DateTime?       @db.Date
  periodEnd   DateTime?       @db.Date
  sourceType  ChargeSource    @default(manual)
  sourceId    String?

  createdById String
  createdBy   User     @relation("ChargeCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("ChargeVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  allocations     Allocation[]
  billedPeriod    BilledPeriod?
  mealOrder       MealOrder?
  adaptationVisit AdaptationVisit?
  package         Package?         @relation("PackageCharge")
  sessionUsage    SessionUsage?    @relation("SessionCharge")

  @@index([childId, category])
  @@index([sourceType, sourceId])
}

model Payment {
  id         String           @id @default(uuid())
  childId    String
  child      Child            @relation(fields: [childId], references: [id])
  amount     Decimal          @db.Decimal(10, 2)
  category   FinanceCategory?
  method     PaymentMethod
  status     PaymentStatus    @default(confirmed)
  reference  String
  receivedAt DateTime
  note       String?
  externalId String?          @unique

  createdById String?
  createdBy   User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  allocations Allocation[]
  invoice     PaymentInvoice?

  @@index([childId])
}

model Allocation {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id])
  chargeId  String
  charge    Charge  @relation(fields: [chargeId], references: [id])
  amount    Decimal @db.Decimal(10, 2)

  createdById String
  createdBy   User     @relation("AllocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("AllocationVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  @@index([paymentId])
  @@index([chargeId])
}

enum TariffUnit {
  month
  hour
  session
  package
}

enum BillingMode {
  anniversary
  calendar_prorated
  calendar_full
}

enum AdjustmentType {
  custom_price
  discount_percent
  discount_amount
  pause
}

model Tariff {
  id            String          @id @default(uuid())
  name          String
  category      FinanceCategory
  unit          TariffUnit
  packageSize   Int?
  billingMode   BillingMode     @default(calendar_full)
  validityDays  Int?
  isActive      Boolean         @default(true)
  institutionId String?
  institution   Institution?    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  prices           TariffPrice[]
  enrollments      Enrollment[]
  adaptationVisits AdaptationVisit[]
  singleGroups     ClassGroup[]      @relation("GroupSingleTariff")
  packageGroups    ClassGroup[]      @relation("GroupPackageTariff")
  packages         Package[]

  @@unique([institutionId, name])
}

model TariffPrice {
  id            String   @id @default(uuid())
  tariffId      String
  tariff        Tariff   @relation(fields: [tariffId], references: [id])
  price         Decimal  @db.Decimal(10, 2)
  effectiveFrom DateTime @db.Date
  createdById   String
  createdBy     User     @relation("TariffPriceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([tariffId, effectiveFrom])
}

model Enrollment {
  id          String       @id @default(uuid())
  childId     String
  child       Child        @relation(fields: [childId], references: [id])
  tariffId    String
  tariff      Tariff       @relation(fields: [tariffId], references: [id])
  startDate   DateTime     @db.Date
  endDate     DateTime?    @db.Date
  billingMode BillingMode?
  note        String?
  createdById String
  createdBy   User         @relation("EnrollmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  adjustments   EnrollmentAdjustment[]
  billedPeriods BilledPeriod[]

  @@index([childId])
}

model EnrollmentAdjustment {
  id           String         @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id])
  type         AdjustmentType
  value        Decimal?       @db.Decimal(10, 2)
  startDate    DateTime       @db.Date
  endDate      DateTime?      @db.Date
  reason       String
  createdById  String
  createdBy    User           @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("AdjustmentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  @@index([enrollmentId])
}

model BilledPeriod {
  id           String     @id @default(uuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id])
  periodStart  DateTime   @db.Date
  periodEnd    DateTime   @db.Date
  amount       Decimal    @db.Decimal(10, 2)
  chargeId     String?    @unique
  charge       Charge?    @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, periodStart])
}

model AdaptationVisit {
  id          String   @id @default(uuid())
  childId     String
  child       Child    @relation(fields: [childId], references: [id])
  tariffId    String
  tariff      Tariff   @relation(fields: [tariffId], references: [id])
  date        DateTime @db.Date
  hours       Decimal  @db.Decimal(5, 2)
  ratePerHour Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  note        String?
  chargeId    String   @unique
  charge      Charge   @relation(fields: [chargeId], references: [id])
  createdById String
  createdBy   User     @relation("AdaptationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("AdaptationVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  @@index([childId])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum MissedLessonRule {
  no_charge
  always
  unexcused_only
}

enum ClassFormat {
  individual
  group
}

enum AttendanceStatus {
  present
  absent_excused
  absent_unexcused
}

model Direction {
  id         String           @id @default(uuid())
  name       String           @unique
  missedRule MissedLessonRule @default(no_charge)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  groups   ClassGroup[]
  packages Package[]
}

model ClassGroup {
  id              String      @id @default(uuid())
  name            String
  directionId     String
  direction       Direction   @relation(fields: [directionId], references: [id])
  format          ClassFormat
  singleTariffId  String?
  singleTariff    Tariff?     @relation("GroupSingleTariff", fields: [singleTariffId], references: [id], onDelete: Restrict)
  packageTariffId String?
  packageTariff   Tariff?     @relation("GroupPackageTariff", fields: [packageTariffId], references: [id], onDelete: Restrict)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  teachers    User[]             @relation("ClassGroupTeachers")
  members     ClassGroupMember[]
  lessons     Lesson[]
  salaryRates SalaryRate[]

  @@unique([directionId, name])
}

model ClassGroupMember {
  id           String     @id @default(uuid())
  classGroupId String
  classGroup   ClassGroup @relation(fields: [classGroupId], references: [id])
  childId      String
  child        Child      @relation(fields: [childId], references: [id])
  startDate    DateTime   @db.Date
  endDate      DateTime?  @db.Date
  createdById  String
  createdBy    User       @relation("MemberCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime   @default(now())

  @@index([classGroupId])
  @@index([childId])
}

model Package {
  id                   String        @id @default(uuid())
  childId              String
  child                Child         @relation(fields: [childId], references: [id])
  directionId          String
  direction            Direction     @relation(fields: [directionId], references: [id])
  tariffId             String?
  tariff               Tariff?       @relation(fields: [tariffId], references: [id], onDelete: Restrict)
  sessionsTotal        Int
  usedBefore           Int           @default(0)
  purchaseDate         DateTime      @db.Date
  expiresAt            DateTime?     @db.Date
  chargeId             String?       @unique
  charge               Charge?       @relation("PackageCharge", fields: [chargeId], references: [id], onDelete: Restrict)
  legacySubscriptionId String?       @unique
  legacySubscription   Subscription? @relation(fields: [legacySubscriptionId], references: [id], onDelete: Restrict)
  needsReconciliation  Boolean       @default(false)
  reconciledAt         DateTime?
  reconciledById       String?
  reconciledBy         User?         @relation("PackageReconciledBy", fields: [reconciledById], references: [id], onDelete: Restrict)
  reconciliationNote   String?
  createdById          String?
  createdBy            User?         @relation("PackageCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt            DateTime      @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("PackageVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  extensions PackageExtension[]
  usages     SessionUsage[]

  @@index([childId, directionId])
}

model PackageExtension {
  id                String    @id @default(uuid())
  packageId         String
  package           Package   @relation(fields: [packageId], references: [id])
  previousExpiresAt DateTime? @db.Date
  newExpiresAt      DateTime  @db.Date
  reason            String
  createdById       String
  createdBy         User      @relation("ExtensionCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime  @default(now())
}

model Lesson {
  id            String     @id @default(uuid())
  classGroupId  String
  classGroup    ClassGroup @relation(fields: [classGroupId], references: [id])
  date          DateTime   @db.Date
  conductedById String
  conductedBy   User       @relation("LessonConductedBy", fields: [conductedById], references: [id])
  createdAt     DateTime   @default(now())

  attendances LessonAttendance[]

  @@unique([classGroupId, date])
}

model LessonAttendance {
  id         String           @id @default(uuid())
  lessonId   String
  lesson     Lesson           @relation(fields: [lessonId], references: [id])
  childId    String
  child      Child            @relation(fields: [childId], references: [id])
  status     AttendanceStatus
  isGuest    Boolean          @default(false)
  markedById String
  markedBy   User             @relation("AttendanceMarkedBy", fields: [markedById], references: [id])
  markedAt   DateTime         @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("AttendanceVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  usage SessionUsage?

  @@index([lessonId])
  @@index([childId])
}

model SessionUsage {
  id           String           @id @default(uuid())
  attendanceId String           @unique
  attendance   LessonAttendance @relation(fields: [attendanceId], references: [id])
  packageId    String?
  package      Package?         @relation(fields: [packageId], references: [id], onDelete: Restrict)
  chargeId     String?          @unique
  charge       Charge?          @relation("SessionCharge", fields: [chargeId], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now())

  voidedAt   DateTime?
  voidedById String?
  voidedBy   User?     @relation("UsageVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason String?

  @@index([packageId])
}

enum GroupKind {
  kindergarten
  school_class
}

enum DailyStatus {
  present
  late
  left_early
  absent
}

enum CalendarDayType {
  non_working
  working
}

enum CalendarScope {
  all
  kindergarten
  school_class
  institution
  group
}

enum NoticeStatus {
  pending
  approved
  rejected
  cancelled
}

model AbsenceReason {
  id               String            @id @default(uuid())
  name             String            @unique
  excused          Boolean
  requiresDocument Boolean           @default(false)
  active           Boolean           @default(true)
  sortOrder        Int               @default(0)
  attendances      DailyAttendance[]
  notices          AbsenceNotice[]
  lessonMarks      LessonMark[]
}

model CalendarDay {
  id            String          @id @default(uuid())
  startDate     DateTime        @db.Date
  endDate       DateTime        @db.Date
  type          CalendarDayType
  scope         CalendarScope
  institutionId String?
  institution   Institution?    @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  groupId       String?
  group         Group?          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  title         String
  createdById   String
  createdBy     User            @relation("CalendarCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())
  voidedAt      DateTime?
  voidedById    String?
  voidedBy      User?           @relation("CalendarVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason    String?

  @@index([startDate, endDate])
}

model DailyAttendance {
  id               String         @id @default(uuid())
  childId          String
  child            Child          @relation(fields: [childId], references: [id])
  groupId          String
  group            Group          @relation(fields: [groupId], references: [id])
  date             DateTime       @db.Date
  status           DailyStatus
  reasonId         String?
  reason           AbsenceReason? @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  note             String?
  documentProvided Boolean        @default(false)
  markedById       String
  markedBy         User           @relation("DailyMarkedBy", fields: [markedById], references: [id])
  createdAt        DateTime       @default(now())
  voidedAt         DateTime?
  voidedById       String?
  voidedBy         User?          @relation("DailyVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason       String?

  @@index([groupId, date])
  @@index([childId, date])
}

model AbsenceNotice {
  id             String        @id @default(uuid())
  childId        String
  child          Child         @relation(fields: [childId], references: [id])
  startDate      DateTime      @db.Date
  endDate        DateTime      @db.Date
  reasonId       String
  reason         AbsenceReason @relation(fields: [reasonId], references: [id])
  comment        String?
  status         NoticeStatus  @default(pending)
  createdById    String
  createdBy      User          @relation("NoticeCreatedBy", fields: [createdById], references: [id])
  decidedById    String?
  decidedBy      User?         @relation("NoticeDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt      DateTime?
  decisionReason String?
  createdAt      DateTime      @default(now())

  @@index([childId, startDate])
}

enum WeekParity {
  every
  odd
  even
}

enum LessonChangeType {
  cancel
  replace
  extra
}

enum LessonStatus {
  present
  late
  absent
}

enum NushLevel {
  needs_support
  progressing
  with_help
  independent
}

model Subject {
  id          String           @id @default(uuid())
  name        String           @unique
  active      Boolean          @default(true)
  entries     TimetableEntry[]
  changes     LessonChange[]
  lessons     SchoolLesson[]
  salaryRates SalaryRate[]
}

model Room {
  id      String           @id @default(uuid())
  name    String           @unique
  active  Boolean          @default(true)
  entries TimetableEntry[]
  changes LessonChange[]
  lessons SchoolLesson[]
}

model BellSchedule {
  id      String       @id @default(uuid())
  name    String       @unique
  active  Boolean      @default(true)
  periods BellPeriod[]
  groups  Group[]
}

model BellPeriod {
  id         String       @id @default(uuid())
  scheduleId String
  schedule   BellSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  number     Int
  startTime  String
  endTime    String

