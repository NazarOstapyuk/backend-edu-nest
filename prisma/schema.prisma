enum PayrollCalendar {
  all
  kindergarten
  school_class
}

enum PayrollLessonType {
  school_lesson
  class_group
  individual
}

enum PayrollStatus {
  draft
  approved
}

enum PayrollLineType {
  base
  allowance
  lesson
  correction
  adjustment
  extra_hours
}

enum PayrollSourceType {
  school_lesson
  class_lesson
}

enum PayrollAdjustmentKind {
  bonus
  deduction
}

enum PayrollPaymentMethod {
  cash
  card
}

model SalaryTerms {
  id            String            @id @default(uuid())
  teacherId     String
  teacher       User              @relation("SalaryTermsTeacher", fields: [teacherId], references: [id])
  validFrom     DateTime          @db.Date
  validTo       DateTime?         @db.Date
  monthlyRate   Decimal           @db.Decimal(12, 2)
  calendarKind  PayrollCalendar   @default(all)
  extraHourRate Decimal?          @db.Decimal(12, 2)
  note          String?
  createdById   String
  createdBy     User              @relation("SalaryTermsCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())
  rates         SalaryRate[]
  allowances    SalaryAllowance[]

  @@index([teacherId, validFrom])
}

model SalaryRate {
  id           String            @id @default(uuid())
  termsId      String
  terms        SalaryTerms       @relation(fields: [termsId], references: [id], onDelete: Cascade)
  lessonType   PayrollLessonType
  subjectId    String?
  subject      Subject?          @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  classGroupId String?
  classGroup   ClassGroup?       @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  amount       Decimal           @db.Decimal(12, 2)

  @@index([termsId])
}

model SalaryAllowance {
  id      String      @id @default(uuid())
  termsId String
  terms   SalaryTerms @relation(fields: [termsId], references: [id], onDelete: Cascade)
  name    String
  amount  Decimal     @db.Decimal(12, 2)

  @@index([termsId])
}

model PayrollSheet {
  id           String              @id @default(uuid())
  teacherId    String
  teacher      User                @relation("PayrollSheetTeacher", fields: [teacherId], references: [id])
  month        DateTime            @db.Date
  status       PayrollStatus       @default(draft)
  workedDays   Int?
  approvedDays Json?
  approvedAt   DateTime?
  approvedById String?
  approvedBy   User?               @relation("PayrollSheetApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  reopenedAt   DateTime?
  reopenedById String?
  reopenedBy   User?               @relation("PayrollSheetReopenedBy", fields: [reopenedById], references: [id], onDelete: Restrict)
  reopenReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  lines        PayrollLine[]
  adjustments  PayrollAdjustment[]
  payments     PayrollPayment[]

  @@unique([teacherId, month])
}

model PayrollLine {
  id         String             @id @default(uuid())
  sheetId    String
  sheet      PayrollSheet       @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  position   Int
  type       PayrollLineType
  sourceType PayrollSourceType?
  sourceId   String?
  lessonType PayrollLessonType?
  date       DateTime?          @db.Date
  refMonth   DateTime?          @db.Date
  title      String
  amount     Decimal            @db.Decimal(12, 2)
  meta       Json?

  @@index([sheetId])
  @@index([sourceType, sourceId])
}

model PayrollAdjustment {
  id          String                @id @default(uuid())
  sheetId     String
  sheet       PayrollSheet          @relation(fields: [sheetId], references: [id])
  kind        PayrollAdjustmentKind
  amount      Decimal               @db.Decimal(12, 2)
  reason      String
  createdById String
  createdBy   User                  @relation("PayrollAdjustmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime              @default(now())
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?                 @relation("PayrollAdjustmentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason  String?

  @@index([sheetId])
}

model PayrollPayment {
  id          String               @id @default(uuid())
  sheetId     String
  sheet       PayrollSheet         @relation(fields: [sheetId], references: [id])
  date        DateTime             @db.Date
  amount      Decimal              @db.Decimal(12, 2)
  method      PayrollPaymentMethod
  comment     String?
  createdById String
  createdBy   User                 @relation("PayrollPaymentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?                @relation("PayrollPaymentVoidedBy", fields: [voidedById], references: [id], onDelete: Restrict)
  voidReason  String?

  @@index([sheetId])
}

enum BackupKind {
  scheduled
  manual
  pre_restore
}

enum BackupStatus {
  running
  succeeded
  failed
}

model BackupRun {
  id          String       @id @default(uuid())
  kind        BackupKind
  status      BackupStatus
  fileName    String?
  sizeBytes   BigInt?
  error       String?
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  createdById String?
  createdBy   User?        @relation("BackupRunCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([startedAt])
}

enum PermissionArea {
  users
  children
  finance
  tariffs
  classes
  register
  timetable
  meals
  payroll
  backups
  settings
  audit
}

enum PermissionLevel {
  view
  edit
}

enum AccessScope {
  all
  institutions
}

model UserPermission {
  id     String          @id @default(uuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  area   PermissionArea
  level  PermissionLevel

  @@unique([userId, area])
}

enum AuditAction {
  create
  update
  delete
  void
}

enum AuthEventType {
  login_success
  login_failed
  logout
  password_changed
  refresh_failed
}

model AuditEvent {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  requestId  String
  actorId    String?
  actor      User?    @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole  Role?
  method     String
  route      String
  entityType String?
  entityId   String?
  statusCode Int
  ip         String?
  userAgent  String?
  body       Json?

  @@index([at])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([requestId])
}

model AuditChange {
  id         String      @id @default(uuid())
  at         DateTime    @default(now())
  requestId  String
  actorId    String?
  actor      User?       @relation("AuditChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     AuditAction
  changes    Json

  @@index([entityType, entityId])
  @@index([requestId])
  @@index([at])
}

model AuthEvent {
  id        String        @id @default(uuid())
  at        DateTime      @default(now())
  userId    String?
  user      User?         @relation("AuthEventUser", fields: [userId], references: [id], onDelete: SetNull)
  login     String
  type      AuthEventType
  reason    String?
  ip        String?
  userAgent String?

  @@index([at])
  @@index([login])
  @@index([userId])
}

enum PaymentRequestSource {
  cabinet
  link
}

enum PaymentRequestStatus {
  open
  paid
  cancelled
  expired
}

enum PaymentProviderKind {
  test
  monobank
}

enum InvoiceStatus {
  pending
  success
  failure
  expired
}

model PaymentRequest {
  id            String               @id @default(uuid())
  childId       String
  child         Child                @relation(fields: [childId], references: [id], onDelete: Restrict)
  category      FinanceCategory
  amount        Decimal              @db.Decimal(10, 2)
  source        PaymentRequestSource
  status        PaymentRequestStatus @default(open)
  linkTokenHash String?              @unique
  comment       String?
  expiresAt     DateTime?
  createdById   String?
  createdBy     User?                @relation("PaymentRequestCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  paidAt        DateTime?
  cancelledAt   DateTime?
  cancelledById String?
  cancelledBy   User?                @relation("PaymentRequestCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  invoices      PaymentInvoice[]

  @@index([childId])
  @@index([status])
}

model PaymentInvoice {
  id            String              @id @default(uuid())
  requestId     String
  request       PaymentRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  provider      PaymentProviderKind
  invoiceId     String              @unique
  pageUrl       String
  amountKop     Int
  status        InvoiceStatus       @default(pending)
  failureReason String?
  paidAt        DateTime?
  checkedAt     DateTime?
  paymentId     String?             @unique
  payment       Payment?            @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  createdAt     DateTime            @default(now())

  @@index([requestId])
  @@index([status])
}

enum InstitutionType {
  kindergarten
  school_class
}

model Institution {
